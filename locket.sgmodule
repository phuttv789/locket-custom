Ini, TOML
#!name=Locket Custom 60s
#!desc=Tự tạo module Locket cá nhân - Quay video 60s

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Tự trỏ đến file locket.js của bạn
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/TEN_GITHUB_CUA_BAN/TEN_REPO/main/locket.js, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/usatalk/shin/main/deleteHeader.js, timeout=60

# 3. Kích hoạt Gold & Ngày 25/05/1111
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/usatalk/shin/main/locket_sub.js, requires-body=true, max-size=-1, timeout=60
